{
  "manifest_version": 3,
  "name": "KVM Watcher",
  "version": "0.1.0",
  "description": "Captures KVM web UI screenshots on a schedule and sends them to a local agent.",
  "permissions": ["alarms", "tabs", "activeTab", "storage"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Set KVM Tab"
  }
}
